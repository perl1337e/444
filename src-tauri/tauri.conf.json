{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mod Manager",
  "version": "0.1.0",
  "identifier": "dev.modmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Mod Manager", "width": 1100, "height": 720, "minWidth": 800, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["nxm", "ror2mm"] } }
  }
}
